+/// Whether a URL may become a link at all. Checked where a URL enters (styled text): a refused URL gets no link id
+/// and its text is kept. Refused: empty or longer than MAX_URL_LENGTH; any byte below 0x20, 0x7f or 0x80-0x9f (C0
+/// and C1 controls, so ESC, BEL and both STs; UTF-8 continuation bytes in that range too, so a URL should be
+/// percent-encoded). Any scheme is kept: an app can still resolve a custom-scheme link (getLinkAt) itself.
+pub fn isStorableUrl(url: []const u8) bool {
+    if (url.len == 0 or url.len > MAX_URL_LENGTH) return false;
+    for (url) |byte| {
+        if (byte < 0x20 or byte == 0x7f or (byte >= 0x80 and byte <= 0x9f)) return false;
+    }
+    return true;
+}
+
+/// Whether a URL may be written to the terminal as an OSC 8 hyperlink: isStorableUrl and a scheme of http, https or
+/// mailto (ASCII case-insensitive). Checked by the renderer for every hyperlink it opens; a refused one opens none.
+pub fn isSafeUrl(url: []const u8) bool {
+    if (!isStorableUrl(url)) return false;
+    const colon = std.mem.findScalar(u8, url, ':') orelse return false;
+    const scheme = url[0..colon];
+    return std.ascii.eqlIgnoreCase(scheme, "http") or
+        std.ascii.eqlIgnoreCase(scheme, "https") or
+        std.ascii.eqlIgnoreCase(scheme, "mailto");
+}
+
+test "isSafeUrl accepts http, https and mailto and refuses controls, other schemes and long URLs" {
