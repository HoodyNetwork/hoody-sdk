+        try std.testing.expect(isSafeUrl(url));
+    }
+    for ([_][]const u8{
+        "",                              "javascript:alert(1)",        "file:///etc/passwd",      "ftp://x",
+        "noscheme",                      ":x",                         "https://a/\x1b]52;c;x\x07", "https://a/\x07",
+        "https://a/\x1b\\",             "https://a/\xc2\x9c",          "https://a/\x9c",          "https://a/\x7f",
+        "https://a/\x00",                "https://a/\n",               "https://a/\x85",
