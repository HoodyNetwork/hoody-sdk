diff -ruN a/packages/core/src/tests/renderer.hyperlinks-option.test.ts b/packages/core/src/tests/renderer.hyperlinks-option.test.ts
--- a/packages/core/src/tests/renderer.hyperlinks-option.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/core/src/tests/renderer.hyperlinks-option.test.ts	2026-11-11 12:33:05.867200266 +0000
@@ -0,0 +1,141 @@
+import { afterEach, test } from "bun:test"
+import assert from "node:assert/strict"
+import { StyledText } from "../lib/styled-text.js"
+import { TextRenderable } from "../renderables/Text.js"
+import type { CliRendererConfig } from "../renderer.js"
+import { ManualClock } from "../testing/manual-clock.js"
+import { createTestRenderer, type TestRendererSetup } from "../testing/test-renderer.js"
+import { RecordingWriteStream } from "../testing/test-streams.js"
+import { MAX_LINK_URL_BYTES } from "../zig.js"
+
+const setups: TestRendererSetup[] = []
+const kitty = "\x1bP>|kitty 0.41.0\x1b\\"
+
+afterEach(async () => {
+  for (const { renderer } of setups.splice(0)) {
+    renderer.destroy()
+    await renderer.closed
+  }
+})
+
+// A remote terminal that reported nothing, so detection alone never enables OSC 8.
+async function setup(config: Partial<CliRendererConfig> = {}, width = 40) {
+  const stdout = new RecordingWriteStream(width, 2)
+  const target = await createTestRenderer({
+    width,
+    height: 2,
+    stdout: stdout as unknown as NodeJS.WriteStream,
+    bufferedOutput: "stdout",
+    remote: true,
+    clock: new ManualClock(),
+    ...config,
+  })
+  setups.push(target)
+  await target.renderer.setupTerminal()
+  stdout.clear()
+  const take = () => {
+    const text = stdout.text()
+    stdout.clear()
+    return text
+  }
+  return { ...target, take }
+}
+
+function openings(output: string) {
+  return [...output.matchAll(/\x1b\]8;id=(\d+);([^\x1b]*)\x1b\\/g)].map((match) => match[2])
+}
+
+function link(target: TestRendererSetup, url: string, text = "label") {
+  const renderable = new TextRenderable(target.renderer, {
+    selectable: false,
+    content: new StyledText([{ __isChunk: true, text, link: { url } }]),
+  })
+  target.renderer.root.add(renderable)
+  return renderable
+}
+
+test("hyperlinks: true writes OSC 8 without any terminal detection", async () => {
+  const target = await setup({ hyperlinks: true })
+  assert.equal(target.renderer.capabilities?.hyperlinks, true)
+  link(target, "https://example.test/a")
+  await target.renderOnce()
+  const output = target.take()
+  assert.deepEqual(openings(output), ["https://example.test/a"])
+  assert.ok(output.includes("\x1b]8;;\x1b\\"), "the link is closed")
+})
+
+test("hyperlinks: false writes no OSC 8 even after a hyperlink terminal identifies itself", async () => {
+  const target = await setup({ hyperlinks: false })
+  link(target, "https://example.test/a")
+  target.renderer.stdin.emit("data", Buffer.from(kitty))
+  await target.renderOnce()
+  assert.deepEqual(openings(target.take()), [])
+  assert.equal(target.renderer.capabilities?.hyperlinks, false)
+})
+
+test("setHyperlinks switches at runtime; null returns to detection", async () => {
+  const target = await setup()
+  link(target, "https://example.test/a")
+  await target.renderOnce()
+  assert.deepEqual(openings(target.take()), [])
+  target.renderer.setHyperlinks(true)
+  await target.renderOnce()
+  assert.deepEqual(openings(target.take()), ["https://example.test/a"])
+  target.renderer.setHyperlinks(null)
+  assert.equal(target.renderer.capabilities?.hyperlinks, false)
+})
+
+test("the native boundary refuses unsafe link URLs and keeps the text", async () => {
+  const refused = [
+    "javascript:alert(1)",
+    "file:///etc/passwd",
+    "ftp://example.test/",
+    "data:text/html,x",
+    "ssh://example.test",
+    "https://example.test/\x1b]52;c;eA==\x07",
+    "https://example.test/\x07",
+    "https://example.test/\x1b\\",
+    "https://example.test/\u009c",
+    "https://example.test/\x7f",
+    "https://example.test/a\nb",
+    "https://example.test/" + "a".repeat(2049 - "https://example.test/".length),
+    "noscheme",
+    ":empty-scheme",
+  ]
+  for (const url of refused) {
+    const target = await setup({ hyperlinks: true })
+    link(target, url, "kept")
+    await target.renderOnce()
+    const output = target.take()
+    assert.deepEqual(openings(output), [], `no link for ${JSON.stringify(url.slice(0, 40))}`)
+    assert.ok(!output.includes("\x1b]8;"), `no OSC 8 at all for ${JSON.stringify(url.slice(0, 40))}`)
+    assert.ok(target.captureCharFrame().includes("kept"), "the text is still drawn")
+  }
+})
+
+test("http, https and mailto URLs up to 2048 bytes are linked", async () => {
+  assert.equal(MAX_LINK_URL_BYTES, 2048)
+  const long = "https://example.test/" + "a".repeat(2048 - "https://example.test/".length)
+  for (const url of ["http://example.test/", "HTTPS://example.test/x?y=1;z", "mailto:someone@example.test", long]) {
+    const target = await setup({ hyperlinks: true })
+    link(target, url)
+    await target.renderOnce()
+    assert.deepEqual(openings(target.take()), [url])
+  }
+})
+
+test("a custom-scheme link stays resolvable in the app but is never written as OSC 8", async () => {
+  const target = await setup({ hyperlinks: true })
+  link(target, "custom+v1://target")
+  await target.renderOnce()
+  assert.equal(target.renderer.getLinkAt(0, 0), "custom+v1://target")
+  assert.ok(!target.take().includes("\x1b]8;"))
+})
+
+test("a URL with a control byte gets no link at all", async () => {
+  const target = await setup({ hyperlinks: true })
+  link(target, "https://example.test/\x1b]52;c;eA==\x07")
+  await target.renderOnce()
+  assert.equal(target.renderer.getLinkAt(0, 0), null)
+  assert.ok(!target.take().includes("\x1b]8;"))
+})
