+export function isStorableLinkUrl(url: string): boolean {
+  if (url.length === 0 || url.length > MAX_LINK_URL_BYTES) return false
+  const bytes = linkUrlEncoder.encode(url)
+  if (bytes.byteLength > MAX_LINK_URL_BYTES) return false
+  for (const byte of bytes) if (byte < 0x20 || byte === 0x7f || (byte >= 0x80 && byte <= 0x9f)) return false
