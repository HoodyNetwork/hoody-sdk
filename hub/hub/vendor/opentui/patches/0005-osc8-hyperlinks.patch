+        try std.testing.expect(!isSafeUrl(url));
+    }
+    var long: [MAX_URL_LENGTH + 1]u8 = undefined;
+    @memset(&long, 'a');
+    @memcpy(long[0..8], "https://");
+    try std.testing.expect(isSafeUrl(long[0..MAX_URL_LENGTH]));
+    try std.testing.expect(!isSafeUrl(&long));
+    try std.testing.expect(isStorableUrl("custom+v1://target"));
+    try std.testing.expect(!isSafeUrl("custom+v1://target"));
+    try std.testing.expect(!isStorableUrl("custom://a\x1b"));
