+// 0006-inverse-once: INVERSE is applied once, by the terminal (SGR 7). The cell keeps the text's own colours.
+import { afterEach, test } from "bun:test"
+import assert from "node:assert/strict"
+import { BoxRenderable } from "../renderables/Box.js"
+import { TextRenderable } from "../renderables/Text.js"
+import { ManualClock } from "../testing/manual-clock.js"
+import { createTestRenderer, type TestRendererSetup } from "../testing/test-renderer.js"
+import { RecordingWriteStream } from "../testing/test-streams.js"
+import { TextAttributes } from "../types.js"
+
+const setups: TestRendererSetup[] = []
+afterEach(async () => {
+  for (const { renderer } of setups.splice(0)) {
+    renderer.destroy()
+    await renderer.closed
+  }
+})
+
+async function draw(text: { fg: string; bg?: string }) {
+  const stdout = new RecordingWriteStream(10, 1)
+  const target = await createTestRenderer({
+    width: 10,
+    height: 1,
+    stdout: stdout as unknown as NodeJS.WriteStream,
+    bufferedOutput: "stdout",
+    remote: true,
+    clock: new ManualClock(),
+    colorMode: "truecolor",
+  })
+  setups.push(target)
+  await target.renderer.setupTerminal()
+  stdout.clear()
+  const box = new BoxRenderable(target.renderer, { width: 10, height: 1, backgroundColor: "#111112" })
+  box.add(new TextRenderable(target.renderer, { content: "INV", ...text, attributes: TextAttributes.INVERSE, selectable: false }))
+  target.renderer.root.add(box)
+  await target.renderOnce()
+  return stdout.text()
+}
+
+/** The SGR runs written before the first glyph of "INV". */
+function sgrBefore(output: string): string {
+  const i = output.indexOf("I")
+  return [...output.slice(0, i).matchAll(/\x1b\[([0-9;]*)m/g)].map((m) => m[1]).join("|")
+}
+
+test("inverse text with no background: written as text fg over the box bg, plus SGR 7 (words stay visible)", async () => {
+  const sgr = sgrBefore(await draw({ fg: "#ededed" }))
+  assert.match(sgr, /38;2;237;237;237/)
+  assert.match(sgr, /48;2;17;17;18/)
+  assert.match(sgr, /(^|[|;])7($|[|;])/)
+  assert.doesNotMatch(sgr, /38;2;237;237;237[^|]*\|.*48;2;237;237;237/) // never fg = bg
+})
+
+test("inverse text with its own background: colours as given, SGR 7 swaps them once", async () => {
+  const sgr = sgrBefore(await draw({ fg: "#ededed", bg: "#202020" }))
+  assert.match(sgr, /38;2;237;237;237/)
+  assert.match(sgr, /48;2;32;32;32/)
+  assert.match(sgr, /(^|[|;])7($|[|;])/)
+})
