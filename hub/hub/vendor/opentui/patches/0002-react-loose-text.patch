diff -ruN a/packages/react/tests/loose-text.test.tsx b/packages/react/tests/loose-text.test.tsx
--- a/packages/react/tests/loose-text.test.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/react/tests/loose-text.test.tsx	2026-11-11 11:21:11.632188849 +0000
@@ -0,0 +1,61 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { act, useState } from "react"
+import { setHostTextFilter } from "../src/index.js"
+import { testRender } from "../src/test-utils.js"
+import { passThroughHostTextFilter } from "./preload.js"
+
+let testSetup: Awaited<ReturnType<typeof testRender>> | undefined
+
+afterEach(() => {
+  if (testSetup) {
+    act(() => testSetup!.renderer.destroy())
+    testSetup = undefined
+  }
+  setHostTextFilter(passThroughHostTextFilter)
+})
+
+describe("loose text", () => {
+  test("a string outside a text node draws as its own text block instead of throwing", async () => {
+    function Label() {
+      return "plain string"
+    }
+    await act(async () => {
+      testSetup = await testRender(
+        <box flexDirection="column">
+          <Label />
+          {"second"}
+          <text>inside</text>
+        </box>,
+        { width: 30, height: 4 },
+      )
+    })
+    await testSetup!.renderOnce()
+    const frame = testSetup!.captureCharFrame()
+    expect(frame).toContain("plain string")
+    expect(frame).toContain("second")
+    expect(frame).toContain("inside")
+  })
+
+  test("loose text is filtered on create and on update", async () => {
+    setHostTextFilter({ ...passThroughHostTextFilter, text: (s: string) => s.replaceAll("\x1b", "?") })
+    let setValue: (s: string) => void = () => {}
+    function App() {
+      const [value, set] = useState("a\x1b[2Jb")
+      setValue = set
+      return <box>{value}</box>
+    }
+    await act(async () => {
+      testSetup = await testRender(<App />, { width: 30, height: 3 })
+    })
+    await testSetup!.renderOnce()
+    expect(testSetup!.captureCharFrame()).toContain("a?[2Jb")
+
+    await act(async () => {
+      setValue("c\x1b]8;;x")
+    })
+    await testSetup!.renderOnce()
+    const frame = testSetup!.captureCharFrame()
+    expect(frame).toContain("c?]8;;x")
+    expect(frame).not.toContain("a?[2Jb")
+  })
+})
