Rationale: shared web code puts bare strings beside elements (`<div>Hi {name}<b>!</b></div>`), which 0.8.4 throws on
("Text must be created inside of a text node"). Loose text outside a text node becomes a text block of its own (a
core TextRenderable) and goes through the same host text filter as 0001, so the Hub's compat runtime draws web
markup without a second, unfiltered path.

diff -ruN a/packages/react/src/reconciler/host-config.ts b/packages/react/src/reconciler/host-config.ts
--- a/packages/react/src/reconciler/host-config.ts	2026-11-11 11:19:56.567817664 +0000
+++ b/packages/react/src/reconciler/host-config.ts	2026-11-11 11:21:11.619203344 +0000
@@ -131,11 +131,14 @@
 
   // Create text instance
   createTextInstance(text: string, rootContainerInstance: Container, hostContext: HostContext) {
+    const filter = hostTextFilter()
     if (!hostContext.isInsideText) {
-      throw new Error("Text must be created inside of a text node")
+      // Text outside a text node becomes its own text block, as a browser makes an anonymous box, instead of
+      // throwing. A component that returns a bare string is common. commitTextUpdate updates its content.
+      return new TextRenderable(rootContainerInstance.ctx, { id: getNextId("text"), content: filter.text(text) })
     }
 
-    return TextNodeRenderable.fromString(hostTextFilter().text(text))
+    return TextNodeRenderable.fromString(filter.text(text))
   },
 
   // Schedule timeout
@@ -176,7 +179,10 @@
   },
 
   commitTextUpdate(textInstance: TextInstance, oldText: string, newText: string) {
-    textInstance.children = [hostTextFilter().text(newText)]
+    const text = hostTextFilter().text(newText)
+    // Loose text (created outside a text node) is a TextRenderable of its own.
+    if (textInstance instanceof TextRenderable) textInstance.content = text
+    else textInstance.children = [text]
   },
 
   // Append child to container
