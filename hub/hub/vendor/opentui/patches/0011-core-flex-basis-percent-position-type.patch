+// CSS Flexbox 9.3: a wrapping row breaks its lines on each item's flex basis, a percentage one included.
+// A "100%" basis must start a line of its own, so the item after it moves to the next line.
+describe("Renderable - percentage flex basis in a wrapping row", () => {
+  test("a 100% basis item takes a line of its own", async () => {
+    const row = new BoxRenderable(testRenderer, { flexDirection: "row", flexWrap: "wrap", width: 40, columnGap: 1 })
+    const first = new BoxRenderable(testRenderer, { width: 29, height: 1, flexShrink: 0 })
+    const breaker = new BoxRenderable(testRenderer, { flexBasis: "100%", height: 0 })
+    const next = new BoxRenderable(testRenderer, { width: 6, height: 1, flexShrink: 0 })
+    row.add(first)
+    row.add(breaker)
+    row.add(next)
+    testRenderer.root.add(row)
+    await renderOnce()
+    expect(breaker.getLayout().width).toBe(40)
+    expect(next.getLayout().top).toBe(1)
+    expect(next.getLayout().left).toBe(0)
+  })
+})
+
+describe("Renderable - positionType getter", () => {
+  test("reads the position from options and later writes", () => {
+    const box = new BoxRenderable(testRenderer, { position: "absolute" })
+    expect(box.positionType).toBe("absolute")
+    box.position = "relative"
+    expect(box.positionType).toBe("relative")
+    box.position = null
+    expect(box.positionType).toBe("relative")
+    expect(new BoxRenderable(testRenderer, {}).positionType).toBe("relative")
+  })
+})
