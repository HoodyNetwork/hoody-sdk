diff -ruN a/packages/react/tests/host-text-filter.test.tsx b/packages/react/tests/host-text-filter.test.tsx
--- a/packages/react/tests/host-text-filter.test.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/react/tests/host-text-filter.test.tsx	2026-11-11 11:24:20.743581619 +0000
@@ -0,0 +1,98 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { act, useState } from "react"
+import { setHostTextFilter } from "../src/index.js"
+import { hostConfig } from "../src/reconciler/host-config.js"
+import { testRender } from "../src/test-utils.js"
+import { passThroughHostTextFilter } from "./preload.js"
+
+let testSetup: Awaited<ReturnType<typeof testRender>> | undefined
+
+// Replaces ESC with "?" in text and in the text props it is asked about; records what it saw.
+function recordingFilter() {
+  const seen = { text: [] as string[], props: [] as string[], prop: [] as string[] }
+  const clean = (s: string) => s.replaceAll("\x1b", "?")
+  return {
+    seen,
+    filter: {
+      text(s: string) {
+        seen.text.push(s)
+        return clean(s)
+      },
+      props(p: object) {
+        const out: Record<string, unknown> = { ...(p as Record<string, unknown>) }
+        for (const k of Object.keys(out)) {
+          seen.props.push(k)
+          if (typeof out[k] === "string") out[k] = clean(out[k] as string)
+        }
+        return out
+      },
+      prop(k: string, v: unknown) {
+        seen.prop.push(k)
+        return typeof v === "string" ? clean(v) : v
+      },
+    },
+  }
+}
+
+afterEach(() => {
+  if (testSetup) {
+    act(() => testSetup!.renderer.destroy())
+    testSetup = undefined
+  }
+  setHostTextFilter(passThroughHostTextFilter)
+})
+
+describe("host text filter", () => {
+  test("is exported and validates its argument", () => {
+    expect(typeof setHostTextFilter).toBe("function")
+    expect(() => setHostTextFilter({ text: (s: string) => s } as never)).toThrow(TypeError)
+  })
+
+  test("fails closed: no filter set means no instance and no text instance", () => {
+    setHostTextFilter(null)
+    const container = {} as never
+    expect(() => hostConfig.createTextInstance("hi", container, { isInsideText: true }, null as never)).toThrow(
+      "TERM_UNSAFE_OUTPUT",
+    )
+    expect(() => hostConfig.createInstance("box", {}, container, { isInsideText: false }, null as never)).toThrow(
+      "TERM_UNSAFE_OUTPUT",
+    )
+    expect(() => hostConfig.commitTextUpdate!({ children: [] } as never, "a", "b")).toThrow("TERM_UNSAFE_OUTPUT")
+  })
+
+  test("routes text instances, text updates, initial props and prop updates through the filter", async () => {
+    const { seen, filter } = recordingFilter()
+    setHostTextFilter(filter)
+    let setLabel: (s: string) => void = () => {}
+    function App() {
+      const [label, set] = useState("one\x1b]52;c;x")
+      setLabel = set
+      return (
+        <box title={"T\x1b[2J" + label.slice(0, 3)} border style={{ width: 30, height: 4 }}>
+          <text>{label}</text>
+        </box>
+      )
+    }
+    await act(async () => {
+      testSetup = await testRender(<App />, { width: 30, height: 4 })
+    })
+    await testSetup!.renderOnce()
+    let frame = testSetup!.captureCharFrame()
+    expect(frame).toContain("one?]52;c;x")
+    expect(frame).toContain("T?[2Jone")
+    expect(frame).not.toContain("\x1b")
+    expect(seen.text).toContain("one\x1b]52;c;x")
+    expect(seen.props).toContain("title")
+    expect(seen.prop).toContain("title")
+    expect(seen.prop).toContain("width")
+
+    await act(async () => {
+      setLabel("two\x1b[31m")
+    })
+    await testSetup!.renderOnce()
+    frame = testSetup!.captureCharFrame()
+    expect(frame).toContain("two?[31m")
+    expect(frame).toContain("T?[2Jtwo")
+    expect(seen.text).toContain("two\x1b[31m")
+  })
+})
