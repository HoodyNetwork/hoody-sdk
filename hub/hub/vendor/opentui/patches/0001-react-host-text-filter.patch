diff -ruN a/packages/react/src/reconciler/host-text-filter.ts b/packages/react/src/reconciler/host-text-filter.ts
--- a/packages/react/src/reconciler/host-text-filter.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/react/src/reconciler/host-text-filter.ts	2026-11-11 11:19:47.614536926 +0000
@@ -0,0 +1,43 @@
+/**
+ * The one filter between React and the engine. Every string the React host hands an engine instance passes through
+ * it: text instances and their updates, the props an instance is constructed with, and every prop (and style entry)
+ * set on an instance afterwards, initial or updated. A host uses it to make text safe to draw (strip terminal control
+ * sequences, refuse unsafe link targets, ...).
+ *
+ * Fail closed: until a filter is set, creating or updating any instance throws `TERM_UNSAFE_OUTPUT`, so nothing is
+ * drawn unfiltered. A host that wants no filtering sets a pass-through filter explicitly.
+ */
+export interface HostTextFilter {
+  /** A text instance's string, as it is created or updated. */
+  text(s: string): string
+  /** The props an instance is constructed with. Return the same object when nothing changes. */
+  props(p: object): object
+  /** One prop or style entry as it is set on an instance (initial set and every update). */
+  prop(k: string, v: unknown): unknown
+}
+
+let current: HostTextFilter | null = null
+
+/** Sets the filter for every root of this module instance; null removes it (rendering then throws). */
+export function setHostTextFilter(f: HostTextFilter | null): void {
+  if (
+    f !== null &&
+    (typeof f !== "object" ||
+      typeof f.text !== "function" ||
+      typeof f.props !== "function" ||
+      typeof f.prop !== "function")
+  ) {
+    throw new TypeError("setHostTextFilter expects an object with text, props and prop functions, or null")
+  }
+  current = f
+}
+
+/** The filter in force. Throws when none is set (fail closed). */
+export function hostTextFilter(): HostTextFilter {
+  if (current === null) {
+    throw new Error(
+      "TERM_UNSAFE_OUTPUT: no host text filter is set; call setHostTextFilter() from @opentui/react before rendering",
+    )
+  }
+  return current
+}
