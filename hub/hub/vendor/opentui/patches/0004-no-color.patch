diff -ruN a/packages/core/src/tests/renderer.no-color.test.ts b/packages/core/src/tests/renderer.no-color.test.ts
--- a/packages/core/src/tests/renderer.no-color.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/core/src/tests/renderer.no-color.test.ts	2026-11-11 11:55:44.357742972 +0000
@@ -0,0 +1,96 @@
+import { afterEach, test } from "bun:test"
+import assert from "node:assert/strict"
+import { RGBA } from "../lib/RGBA.js"
+import { TextRenderable } from "../renderables/Text.js"
+import type { CliRendererConfig } from "../renderer.js"
+import { ManualClock } from "../testing/manual-clock.js"
+import { createTestRenderer, type TestRendererSetup } from "../testing/test-renderer.js"
+import { RecordingWriteStream } from "../testing/test-streams.js"
+import { TextAttributes } from "../types.js"
+
+const setups: TestRendererSetup[] = []
+
+afterEach(async () => {
+  for (const { renderer } of setups.splice(0)) {
+    renderer.destroy()
+    await renderer.closed
+  }
+})
+
+async function setup(config: Partial<CliRendererConfig>) {
+  const stdout = new RecordingWriteStream(12, 2)
+  const target = await createTestRenderer({
+    width: 12,
+    height: 2,
+    stdout: stdout as unknown as NodeJS.WriteStream,
+    bufferedOutput: "stdout",
+    remote: true,
+    clock: new ManualClock(),
+    ...config,
+  })
+  setups.push(target)
+  await target.renderer.setupTerminal()
+  stdout.clear()
+  target.renderer.root.add(
+    new TextRenderable(target.renderer, {
+      content: "focus",
+      fg: "#ff0000",
+      bg: "#0000ff",
+      attributes: TextAttributes.BOLD | TextAttributes.UNDERLINE | TextAttributes.INVERSE,
+      selectable: false,
+    }),
+  )
+  target.renderer.root.add(
+    new TextRenderable(target.renderer, {
+      content: "slot",
+      position: "absolute",
+      top: 1,
+      fg: RGBA.fromIndex(3),
+      bg: RGBA.defaultBackground(),
+      selectable: false,
+    }),
+  )
+  await target.renderOnce()
+  return { ...target, output: stdout.text() }
+}
+
+// Any color SGR parameter: 30-39, 40-49, 90-97, 100-107 (and so 38;2 / 38;5 / 48;...).
+function colorParameters(output: string): string[] {
+  const found: string[] = []
+  for (const match of output.matchAll(/\x1b\[([0-9;]*)m/g)) {
+    for (const parameter of match[1]!.split(";")) {
+      const n = Number(parameter)
+      if (parameter !== "" && ((n >= 30 && n <= 49) || (n >= 90 && n <= 97) || (n >= 100 && n <= 107))) {
+        found.push(match[0]!)
+        break
+      }
+    }
+  }
+  return found
+}
+
+test("mono writes no color SGR but keeps bold, underline and reverse", async () => {
+  const { output, renderer } = await setup({ colorMode: "mono" })
+  assert.equal(renderer.colorMode, "mono")
+  assert.deepEqual(colorParameters(output), [])
+  assert.ok(output.includes("focus"))
+  assert.ok(output.includes("\x1b[1m"), "bold stays")
+  assert.ok(output.includes("\x1b[4m"), "underline stays")
+  assert.ok(output.includes("\x1b[7m"), "reverse stays")
+})
+
+test("NO_COLOR selects mono when colorMode is omitted", async () => {
+  const { output, renderer } = await setup({ environment: { NO_COLOR: "1" } })
+  assert.equal(renderer.colorMode, "mono")
+  assert.deepEqual(colorParameters(output), [])
+})
+
+test("an empty NO_COLOR is ignored and an explicit colorMode wins over NO_COLOR", async () => {
+  const empty = await setup({ environment: { NO_COLOR: "" } })
+  assert.equal(empty.renderer.colorMode, "auto")
+  assert.notDeepEqual(colorParameters(empty.output), [])
+  const explicit = await setup({ environment: { NO_COLOR: "1" }, colorMode: "ansi16" })
+  assert.equal(explicit.renderer.colorMode, "ansi16")
+  // The reverse attribute swaps the cell's colors in the buffer: red becomes the background.
+  assert.ok(explicit.output.includes("\x1b[101m") && explicit.output.includes("\x1b[94m"))
+})
