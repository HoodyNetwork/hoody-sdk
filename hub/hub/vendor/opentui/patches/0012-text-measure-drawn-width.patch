+  test.each([
+    [40, 1, 1, 1],
+    [41, 1, 1, 1],
+    [43, 3, 2, 2],
+    [47, 5, 3, 1],
+    [50, 1, 3, 3],
+    [37, 4, 3, 3],
+  ])("row %i split %i:%i:%i", async (width, a, b, c) => {
+    const row = new BoxRenderable(testRenderer, { flexDirection: "row", width, flexShrink: 0, alignItems: "flex-start" })
+    const middle = new BoxRenderable(testRenderer, { flexGrow: b, flexBasis: 0, flexDirection: "column", minWidth: 0 })
+    const text = new TextRenderable(testRenderer, { content: T, wrapMode: "word" })
+    row.add(new BoxRenderable(testRenderer, { flexGrow: a, flexBasis: 0, height: 1 }))
+    row.add(middle)
+    row.add(new BoxRenderable(testRenderer, { flexGrow: c, flexBasis: 0, height: 1 }))
+    middle.add(text)
+    testRenderer.root.add(row)
+    await renderOnce()
