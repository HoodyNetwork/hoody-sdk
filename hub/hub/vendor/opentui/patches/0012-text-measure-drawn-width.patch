+    /// hoody: Yoga measures a text at the width it computes (say 18.83 cells: 18 cells, 4 lines)
+    /// and rounds the box afterwards from its edges (19 cells: 3 lines drawn), so the box kept an
+    /// empty row. A text whose last exact measure used other cells than its rounded box draws, and
+    /// gets another line count at the drawn width, is hinted to measure that same request at the
+    /// drawn width and invalidated. True: solve again.
+    /// Only exact measures: the box width is then fixed, so the drawn width does not depend on the
+    /// result. `|layout.width - input| < 1` keeps out a final size Yoga took from an earlier cached
+    /// call at another width (its rounding would not belong to the recorded measure).
+    /// `restart` drops every hint and invalidates each text whose last measure was not at the floor
+    /// of its width, so the next solve starts as a fresh layout would (a layout can have two
+    /// settled states; a frame must not depend on which one an earlier frame took).
+    fn fitDrawnWidths(self: *Scene, restart: bool) bool {
+        var changed = false;
+        var cursor = self.head;
+        while (cursor) |value| : (cursor = value.scene_node.?.next) {
+            if (value.measure_target == .none) continue;
+            const fit = &value.fit;
+            if (!std.math.isFinite(fit.input)) continue;
+            const base = native.measureCells(fit.input);
+            if (restart) {
+                fit.hint_cells = 0;
+                if (fit.cells != base) {
+                    fit.cells = base;
+                    yoga.yogaNodeInvalidateMeasure(value.yoga_node);
+                    changed = true;
+                }
+                continue;
+            }
+            var layout: yoga.ExternalYogaLayout = undefined;
+            yoga.yogaNodeGetComputedLayout(value.yoga_node, &layout);
+            if (!std.math.isFinite(layout.width) or @abs(layout.width - fit.input) >= 1) continue;
+            const drawn = native.measureCells(layout.width);
+            if (drawn == fit.cells or drawn == fit.same_lines_cells) continue;
+            // A failed measure keeps the floor measure; Yoga's own call reports errors.
+            // This measure runs outside Yoga and leaves nothing a later measure or draw reads as
+            // input: `measureForDimensions` only fills the view's own memos (the per-width measure
+            // cache and the measure ledger, both keyed by width, wrap mode, offset and the content
+            // measured; at the render width it brings the wrapped lines up to date, as the frame
+            // would next). Each holds a pure function of the text and the width, so a result is
+            // the same whether or not this call happened; it can only evict a cached width.
+            const at_drawn = (value.measureTarget(drawn, fit.height_cells) catch continue) orelse continue;
+            if (at_drawn.line_count == fit.lines) {
+                // Same height at the drawn width: an exact box ignores the measured width, so the
+                // layout already is the one a measure at `drawn` gives.
+                fit.same_lines_cells = drawn;
+                continue;
+            }
+            fit.hint_cells = if (drawn == base) 0 else drawn;
+            fit.hint_input = fit.input;
+            yoga.yogaNodeInvalidateMeasure(value.yoga_node);
+            changed = true;
+        }
+        return changed;
+    }
+
+    fn dropFitHints(self: *Scene) void {
+        var cursor = self.head;
+        while (cursor) |value| : (cursor = value.scene_node.?.next) value.fit.hint_cells = 0;
+    }
