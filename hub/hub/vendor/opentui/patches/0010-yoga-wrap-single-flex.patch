+// A wrapping row breaks its lines on each item's flex basis (CSS Flexbox 9.3). Upstream's single
+// flexible child shortcut set that basis to 0, so a grow+shrink item of basis 40 stayed on a
+// 73-wide line beside 44 cells and was squeezed to 28. Without wrap the shortcut still applies.
+test "Yoga wrap-single-flex patch breaks a wrapping line on the flexible item's basis" {
+    const point = @backingInt(yoga.YogaUnit.point);
+    for ([_]struct { u32, f32, [4]f32 }{
+        // flex_wrap, the flexible item's basis, then its left, top, width, height.
+        .{ @import("context_abi_c").OT_FLEX_WRAP_WRAP, 40, .{ 0, 1, 73, 1 } },
+        .{ @import("context_abi_c").OT_FLEX_WRAP_NONE, 40, .{ 45, 0, 28, 1 } },
+        // An item that fits stays on the line, as without wrap.
+        .{ @import("context_abi_c").OT_FLEX_WRAP_WRAP, 20, .{ 45, 0, 28, 1 } },
+    }) |row| {
+        const config = yoga.yogaConfigCreate();
+        defer std.debug.assert(yoga.yogaConfigFree(config));
+        const root = yoga.yogaNodeCreateWithConfig(config);
+        defer yoga.yogaNodeFreeRecursive(root);
+        yoga.yogaNodeStyleSetEnum(root, @backingInt(yoga.YogaEnumKind.flex_direction), @backingInt(yoga.YogaFlexDirection.row));
+        yoga.yogaNodeStyleSetEnum(root, @backingInt(yoga.YogaEnumKind.flex_wrap), row[0]);
+        yoga.yogaNodeStyleSetEnum(root, @backingInt(yoga.YogaEnumKind.align_items), @import("context_abi_c").OT_ALIGN_FLEX_START);
+        yoga.yogaNodeStyleSetValue(root, @backingInt(yoga.YogaValueKind.gap), @import("context_abi_c").OT_GUTTER_COLUMN, point, 1);
+        const fixed = yoga.yogaNodeCreateWithConfig(config);
+        yoga.yogaNodeInsertChild(root, fixed, 0);
+        yoga.yogaNodeStyleSetValue(fixed, @backingInt(yoga.YogaValueKind.width), 0, point, 44);
+        yoga.yogaNodeStyleSetValue(fixed, @backingInt(yoga.YogaValueKind.height), 0, point, 1);
+        const flexible = yoga.yogaNodeCreateWithConfig(config);
+        yoga.yogaNodeInsertChild(root, flexible, 1);
+        yoga.yogaNodeStyleSetFloat(flexible, @backingInt(yoga.YogaFloatKind.flex_grow), 1);
+        yoga.yogaNodeStyleSetFloat(flexible, @backingInt(yoga.YogaFloatKind.flex_shrink), 1);
+        yoga.yogaNodeStyleSetValue(flexible, @backingInt(yoga.YogaValueKind.flex_basis), 0, point, row[1]);
+        yoga.yogaNodeStyleSetValue(flexible, @backingInt(yoga.YogaValueKind.height), 0, point, 1);
+        yoga.yogaNodeCalculateLayout(root, 73, std.math.nan(f32), @backingInt(yoga.YogaDirection.ltr));
+        var layout: yoga.ExternalYogaLayout = undefined;
+        yoga.yogaNodeGetComputedLayout(flexible, &layout);
+        try std.testing.expectEqual(row[2], [4]f32{ layout.left, layout.top, layout.width, layout.height });
+    }
+}
