+// hoody: line wrapping breaks only where the web does (utf8.asciiPunctLineBreak); word motion is unchanged.
+fn hoodyLineStarts(text: []const u8, width: u32) ![]const u32 {
+    var pools = TestPools.init(std.testing.allocator);
+    defer pools.deinit();
+    var tb = try TextBuffer.init(std.testing.allocator, &pools.graphemes, &pools.links, .wcwidth);
+    defer tb.deinit();
+    var view = try TextBufferView.init(std.testing.allocator, tb);
+    defer view.deinit();
+    try tb.setText(text);
+    view.setWrapMode(.word);
+    view.setWrapWidth(width);
+    return std.testing.allocator.dupe(u32, view.getCachedLineInfo().line_start_cols);
+}
+
+test "TextBufferView word wrapping - hoody web break set" {
+    const cases = [_]struct { text: []const u8, width: u32, starts: []const u32 }{
+        .{ .text = "cost $0.25", .width = 8, .starts = &.{ 0, 5 } }, // not "$0." / "25"
+        .{ .text = "run -exec now", .width = 5, .starts = &.{ 0, 4, 10 } }, // word-initial hyphen stays
+        .{ .text = "x sonnet-4.5z", .width = 10, .starts = &.{ 0, 2, 12 } }, // no break after "." or before a digit
+        .{ .text = "self-contained", .width = 10, .starts = &.{ 0, 5 } }, // a hyphen after a word still breaks
+        .{ .text = "path/to/file", .width = 8, .starts = &.{ 0, 8 } }, // slash still breaks
+        .{ .text = "spreads (DNS).", .width = 10, .starts = &.{ 0, 8 } }, // never "spreads (" / "DNS)."
+        .{ .text = "ab [cd] e", .width = 5, .starts = &.{ 0, 3, 8 } }, // no break after an opening bracket
+        .{ .text = "ab {cd} e", .width = 5, .starts = &.{ 0, 3, 8 } },
+    };
+    for (cases) |c| {
+        const got = try hoodyLineStarts(c.text, c.width);
+        defer std.testing.allocator.free(got);
+        std.testing.expectEqualSlices(u32, c.starts, got) catch |err| {
+            std.debug.print("case {s} @ {d}\n", .{ c.text, c.width });
+            return err;
+        };
+    }
+}
