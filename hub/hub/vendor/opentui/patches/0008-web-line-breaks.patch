+/// hoody: whether LINE wrapping may break after the ASCII punctuation byte `b`, following the web's line-break rules
+/// (UAX #14 as browsers apply them) for the bytes around it on the same source line (`prev`/`next` null at the line's
+/// start/end; callers look across chunks). Word motion keeps every punctuation break; only line wrapping asks this.
+/// `.` `,` `;` `:` (IS) never open a break of their own ("$0.25", "4.5", "a,b"): a space after them is the break.
+/// `-` (HY) breaks only after a word and not before a digit ("5-with" may break; "-exec", "--flag", "sonnet-4" may not).
+/// `\\` (PR) and `(` `[` `{` (OP) never break after; `)` (CP) not before a letter or digit. `/` keeps its break except
+/// before a digit; `!` `?` `]` `}` keep theirs.
+pub fn asciiPunctLineBreak(prev: ?u8, b: u8, next: ?u8) bool {
+    const next_digit = if (next) |n| n >= '0' and n <= '9' else false;
+    const next_alnum = if (next) |n| (n >= '0' and n <= '9') or (n >= 'a' and n <= 'z') or (n >= 'A' and n <= 'Z') else false;
+    return switch (b) {
+        '.', ',', ';', ':' => false,
+        '-' => blk: {
+            const p = prev orelse break :blk false;
+            if (p == ' ' or p == '\t' or p == '-' or p == '(' or p == '[' or p == '{') break :blk false;
+            break :blk !next_digit;
+        },
+        '\\', '(', '[', '{' => false,
+        ')' => !next_alnum,
+        '/' => !next_digit,
+        else => true,
+    };
+}
+
+/// hoody: whether asciiPunctLineBreak's answer for `b` depends on the byte after it.
+pub fn asciiPunctLineBreakNeedsNext(b: u8) bool {
+    return b == '-' or b == ')' or b == '/';
+}
