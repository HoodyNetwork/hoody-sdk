diff -ruN a/packages/core/src/tests/renderer.color-mode.test.ts b/packages/core/src/tests/renderer.color-mode.test.ts
--- a/packages/core/src/tests/renderer.color-mode.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/core/src/tests/renderer.color-mode.test.ts	2026-11-11 11:28:48.644607332 +0000
@@ -0,0 +1,107 @@
+import { afterEach, test } from "bun:test"
+import assert from "node:assert/strict"
+import { RGBA } from "../lib/RGBA.js"
+import { TextRenderable } from "../renderables/Text.js"
+import type { ColorMode } from "../renderer.js"
+import { ManualClock } from "../testing/manual-clock.js"
+import { createTestRenderer, type TestRendererSetup } from "../testing/test-renderer.js"
+import { RecordingWriteStream } from "../testing/test-streams.js"
+
+const setups: TestRendererSetup[] = []
+
+afterEach(async () => {
+  for (const { renderer } of setups.splice(0)) {
+    renderer.destroy()
+    await renderer.closed
+  }
+})
+
+// A remote terminal that reported nothing: "auto" writes 24-bit colors there.
+async function setup(colorMode?: ColorMode) {
+  const stdout = new RecordingWriteStream(12, 2)
+  const target = await createTestRenderer({
+    width: 12,
+    height: 2,
+    stdout: stdout as unknown as NodeJS.WriteStream,
+    bufferedOutput: "stdout",
+    remote: true,
+    clock: new ManualClock(),
+    ...(colorMode === undefined ? {} : { colorMode }),
+  })
+  setups.push(target)
+  await target.renderer.setupTerminal()
+  stdout.clear()
+  const take = () => {
+    const text = stdout.text()
+    stdout.clear()
+    return text
+  }
+  return { ...target, take }
+}
+
+function draw(target: TestRendererSetup) {
+  target.renderer.root.add(
+    new TextRenderable(target.renderer, { content: "red", fg: "#ff0000", bg: "#0000ff", selectable: false }),
+  )
+  target.renderer.root.add(
+    new TextRenderable(target.renderer, {
+      content: "slot",
+      position: "absolute",
+      top: 1,
+      fg: RGBA.fromIndex(3),
+      bg: RGBA.defaultBackground(),
+      selectable: false,
+    }),
+  )
+}
+
+const TRUECOLOR = /\x1b\[(38|48);2;/
+const SGR16 = (code: number) => `\x1b[${code}m`
+
+test("auto keeps 24-bit colors on a terminal that reported nothing", async () => {
+  const target = await setup()
+  assert.equal(target.renderer.colorMode, "auto")
+  draw(target)
+  await target.renderOnce()
+  assert.match(target.take(), /\x1b\[38;2;255;0;0m/)
+})
+
+test("ansi16 writes SGR 30-37/90-97 and 40-47/100-107, never 38;2 or 38;5", async () => {
+  const target = await setup("ansi16")
+  draw(target)
+  await target.renderOnce()
+  const output = target.take()
+  assert.doesNotMatch(output, TRUECOLOR)
+  assert.doesNotMatch(output, /\x1b\[(38|48);5;/)
+  assert.ok(output.includes(SGR16(91)), "#ff0000 is bright red (palette 9)")
+  assert.ok(output.includes(SGR16(104)), "#0000ff background is bright blue (palette 12)")
+  assert.ok(output.includes(SGR16(33)), "RGBA.fromIndex(3) keeps its slot")
+  assert.ok(output.includes("\x1b[49m"), "a default background stays SGR 49")
+})
+
+test("ansi256 writes palette indexes", async () => {
+  const target = await setup("ansi256")
+  draw(target)
+  await target.renderOnce()
+  const output = target.take()
+  assert.doesNotMatch(output, TRUECOLOR)
+  assert.match(output, /\x1b\[38;5;9m/)
+  assert.match(output, /\x1b\[38;5;3m/)
+})
+
+test("colorMode can change at runtime and repaints with the new mode", async () => {
+  const target = await setup("truecolor")
+  draw(target)
+  await target.renderOnce()
+  assert.match(target.take(), TRUECOLOR)
+  target.renderer.colorMode = "ansi16"
+  assert.equal(target.renderer.colorMode, "ansi16")
+  await target.renderOnce()
+  const output = target.take()
+  assert.ok(output.includes(SGR16(91)))
+  assert.doesNotMatch(output, TRUECOLOR)
+})
+
+test("an unknown colorMode is refused", async () => {
+  await assert.rejects(setup("bogus" as ColorMode), TypeError)
+})
