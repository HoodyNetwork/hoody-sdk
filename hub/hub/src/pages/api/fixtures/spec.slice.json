       "type": "integer",
       "minimum": 100,
       "maximum": 599
      }
     },
     {
      "name": "maxStatus",
      "in": "query",
      "schema": {
       "type": "integer",
       "minimum": 100,
       "maximum": 599
      }
     },
     {
      "name": "exposure",
