{
  // The Hub v3 browser app (hub/src). Scripts and tool configs are checked by tsconfig.node.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@kit": ["./src/kit/index.ts"],
      "@kit/*": ["./src/kit/*"],
      "@core": ["./src/core/index.ts"],
      "@core/*": ["./src/core/*"],
      "@app/*": ["./src/app/*"],
      "@shell/*": ["./src/shell/*"],
      "@ask/io": ["./src/ask/io.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/term/**",
    "src/**/*.term.ts",
    "src/**/*.term.tsx",
    "src/**/*.term.test.ts",
    "src/**/*.term.test.tsx",
    "src/kit/agent/sessionWindow.ts",
    "src/kit/agent/tableWidths.ts",
    "src/kit/agent/termKeyLine.tsx",
    "src/kit/data/DataTableTermLayout.ts",
    "src/kit/data/termFlow.tsx",
    "src/kit/data/termIcons.ts",
    "src/kit/icons.glyphs.ts",
    "src/kit/controls/termPress.tsx",
    "src/kit/forms/termField.tsx",
    "src/kit/layouts/scrollOwner.tsx",
    "src/kit/layouts/termHarness.tsx",
    "src/kit/layouts/termScroll.tsx",
    "src/kit/qr/termQrDialog.tsx",
    "src/kit/layouts/termParts.tsx",
    "src/kit/layouts/termTabs.tsx",
    "src/kit/layouts/anatomy/termSection.tsx",
    "src/kit/data/termCopyText.ts",
    "src/kit/data/listRow.ts",
    "src/kit/pickers/termStop.tsx",
    "src/kit/states/termCopy.ts"
  ]
}
