{
  "name": "@hoody/hub",
  "version": "1.0.1",
  "private": true,
  "description": "Hoody Hub: the web app for Hoody Computers, as source. Builds the served Hub and the one-file hoody-hub.html.",
  "license": "Apache-2.0",
  "homepage": "https://hoody.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoodyNetwork/hoody-sdk.git",
    "directory": "hub"
  },
  "bugs": {
    "url": "https://github.com/HoodyNetwork/hoody-sdk/issues"
  },
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun hub/scripts/dev.ts",
    "build": "bun hub/scripts/build.ts",
    "build-single": "bun hub/scripts/build-single.ts",
    "test": "node --wasm-max-mem-pages=4096 node_modules/vitest/vitest.mjs run --config hub/vite.config.mts --configLoader runner",
    "test:term": "cd hub && NODE_ENV=test bun scripts/term/check.ts --only tests",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=6144 tsc -p hub/tsconfig.json --noEmit && cd hub && NODE_ENV=test bun scripts/term/check.ts --only types",
    "lint": "cd hub && eslint src && stylelint --config stylelint.config.mjs --allow-empty-input 'src/**/*.css'",
    "check": "bun hub/scripts/check.ts",
    "term:build": "cd hub && NODE_ENV=test bun scripts/term/build.ts",
    "hub:build": "bun hub/scripts/build.ts",
    "hub:build-single": "bun hub/scripts/build-single.ts",
    "hub:vitest": "node --wasm-max-mem-pages=4096 node_modules/vitest/vitest.mjs run --config hub/vite.config.mts --configLoader runner",
    "hub:dev": "bun hub/scripts/dev.ts",
    "hub:check": "bun hub/scripts/check.ts",
    "hub:new-page": "bun hub/scripts/new-page.ts",
    "hub:term-build": "cd hub && NODE_ENV=test bun scripts/term/build.ts",
    "hub:term-test": "cd hub && NODE_ENV=test bun scripts/term/check.ts --only tests",
    "hub:board-sync": "HUB_BOARD_SYNC=1 node --wasm-max-mem-pages=4096 node_modules/vitest/vitest.mjs run --config hub/vite.config.mts --configLoader runner hub/src/pages/board/embed/embed.sync.test.ts",
    "hub:shots": "bun hub/scripts/shots.ts",
    "hub:term-dev": "cd hub && NODE_ENV=test bun scripts/term/dev.ts",
    "hub:term-check": "cd hub && NODE_ENV=test bun scripts/term/check.ts",
    "hub:term-ship-gate": "cd hub && NODE_ENV=test bun scripts/term/build/ship-gate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@internationalized/date": "3.12.4",
    "@noble/hashes": "2.4.0",
    "@opentui/core": "file:hub/vendor/opentui/0.8.4-hoody.3/opentui-core-0.8.4-hoody.3.tgz",
    "@opentui/react": "file:hub/vendor/opentui/0.8.4-hoody.3/opentui-react-0.8.4-hoody.3.tgz",
    "@playwright/test": "1.64.1",
    "@tanstack/history": "1.162.5",
    "@tanstack/query-core": "5.105.3",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.26",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "dom-accessibility-api": "0.5.16",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.4",
    "js-yaml": "5.5.0",
    "jsqr": "1.4.0",
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.2.0",
    "postcss-value-parser": "4.2.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-stately": "3.51.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "use-sync-external-store": "1.7.0",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "web-tree-sitter": "0.25.10",
    "ws": "8.22.2"
  },
  "optionalDependencies": {
    "@opentui/core-linux-arm64": "file:hub/vendor/opentui/0.8.4-hoody.3/opentui-core-linux-arm64-0.8.4-hoody.3.tgz",
    "@opentui/core-linux-x64": "file:hub/vendor/opentui/0.8.4-hoody.3/opentui-core-linux-x64-0.8.4-hoody.3.tgz"
  },
  "overrides": {
    "@opentui/core": "file:hub/vendor/opentui/0.8.4-hoody.3/opentui-core-0.8.4-hoody.3.tgz",
    "@opentui/core-linux-arm64": "file:hub/vendor/opentui/0.8.4-hoody.3/opentui-core-linux-arm64-0.8.4-hoody.3.tgz",
    "@opentui/core-linux-x64": "file:hub/vendor/opentui/0.8.4-hoody.3/opentui-core-linux-x64-0.8.4-hoody.3.tgz"
  },
  "patchedDependencies": {
    "@tanstack/react-query@5.105.3": "patches/@tanstack%2Freact-query@5.105.3.patch"
  }
}
